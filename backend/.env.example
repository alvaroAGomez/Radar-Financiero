PORT=3000

# Dolar APIs
DOLAR_API_URL=https://dolarapi.com/v1/dolares
BLUELYTICS_API_URL=https://api.bluelytics.com.ar/v2/latest

# Crypto APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Market & Cauciones APIs
IOL_API_URL=https://api.invertironline.com
IOL_USERNAME=
IOL_PASSWORD=

# URL interna para consumir la API de datos de cauciones (backend → backend)
CAUCION_BOT_URL=api de causiones 

# Timeout Configurations (in milliseconds)
HTTP_TIMEOUT=5000

# --- Links públicos a Telegram bots (expuestos al cliente Angular via GET /api/config) ---
# Son las URLs que el usuario abre en el navegador para acceder al bot de Telegram.
# NO confundir con CAUCION_BOT_URL, que es un endpoint interno de datos.
TELEGRAM_BOT_CAUCIONES_URL=https://t.me/tu_bot_cauciones
TELEGRAM_BOT_DIVIDENDOS_URL=https://t.me/tu_bot_dividendos
